{
  "manifest_version": 3,
  "name": "Canvas to Obsidian Sync",
  "version": "0.2.4",
  "description": "Collect Canvas course data from your browser session and send to Obsidian.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "canvas-to-obsidian-sync@local.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.instructure.com/*",
    "https://*.canvaslms.com/*",
    "https://*.canvas.com/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.instructure.com/*",
    "https://*.canvaslms.com/*",
    "https://*.canvas.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
