{
  "name": "obsidian-canvas-sync",
  "version": "0.2.5",
  "private": true,
  "license": "MIT",
  "description": "Sync Canvas LMS courses, modules, assignments, grades, discussions, files, and calendars directly into Obsidian as Markdown",
  "author": "Joshua A. Wortz <security@codeandcypher.com> (https://github.com/SixFiveMil)",
  "repository": {
    "type": "git",
    "url": "https://github.com/SixFiveMil/obsidian-canvas-sync.git"
  },
  "homepage": "https://codeandcypher.com/projects",
  "bugs": {
    "url": "https://github.com/SixFiveMil/obsidian-canvas-sync/issues"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "canvas-lms",
    "canvas-api",
    "markdown",
    "local-first",
    "education"
  ],
  "workspaces": [
    "apps/obsidian-plugin"
  ],
  "scripts": {
    "build": "npm run build -w apps/obsidian-plugin && node -e \"require('fs').copyFileSync('apps/obsidian-plugin/main.js', 'main.js')\"",
    "dev": "npm run dev -w apps/obsidian-plugin",
    "build:plugin": "npm run build -w apps/obsidian-plugin && node -e \"require('fs').copyFileSync('apps/obsidian-plugin/main.js', 'main.js')\"",
    "typecheck": "tsc -p apps/obsidian-plugin/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
