{
  "name": "obsidian-canvas-sync",
  "version": "0.4.2",
  "main": "main.js",
  "description": "Sync Canvas LMS courses, modules, assignments, grades, discussions, files, and calendars directly into your vault as clean Markdown.",
  "author": "Joshua A. Wortz <security@codeandcypher.com> (https://github.com/SixFiveMil)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SixFiveMil/obsidian-canvas-sync.git"
  },
  "homepage": "https://codeandcypher.com/projects",
  "bugs": {
    "url": "https://github.com/SixFiveMil/obsidian-canvas-sync/issues"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "canvas-lms",
    "canvas-api",
    "markdown",
    "local-first",
    "education"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bridge": "node scripts/test-bridge.mjs",
    "version": "node scripts/sync-version.mjs",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "obsidian": "latest",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
